# AVX local settings. Copy this file to `.env` (never commit `.env`; it is in .gitignore)
# and fill in the values.
#
# For local work and the e2e tests, point it at the TEST Supabase project, not production:
# Supabase dashboard → the test project → Project Settings → API.
# Production builds don't use this file: Vercel reads these from
# Vercel → Settings → Environment Variables (Production and Preview).

# Project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://your-test-project-ref.supabase.co
# The anon (public) or publishable key. Never put the service_role key here.
VITE_SUPABASE_ANON_KEY=your-test-project-anon-key

# Shown on the privacy/terms pages for data requests (optional but recommended)
VITE_CONTACT_EMAIL=
# Error monitoring — paste a Sentry DSN to enable (optional)
VITE_SENTRY_DSN=
